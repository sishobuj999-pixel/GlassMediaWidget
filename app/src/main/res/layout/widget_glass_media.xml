<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical" android:background="@drawable/glass_widget_bg">
<ImageView android:id="@+id/artwork" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="Artwork"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp"><TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nothing playing" android:textSize="16sp" android:textColor="#FFFFFFFF" android:maxLines="1"/><TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open a media app" android:textSize="12sp" android:textColor="#BFFFFFFF" android:maxLines="1"/></LinearLayout>
<TextView android:id="@+id/previous" android:layout_width="40dp" android:layout_height="48dp" android:gravity="center" android:text="◀" android:textSize="20sp" android:textColor="#FFFFFFFF"/><TextView android:id="@+id/play_pause" android:layout_width="44dp" android:layout_height="48dp" android:gravity="center" android:text="▶" android:textSize="22sp" android:textColor="#FFFFFFFF"/><TextView android:id="@+id/next" android:layout_width="40dp" android:layout_height="48dp" android:gravity="center" android:text="▶▶" android:textSize="16sp" android:textColor="#FFFFFFFF"/>
</LinearLayout>
